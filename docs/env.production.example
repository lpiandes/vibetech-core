# Production environment template for app.vtechdevelopment.com
# Copy into your secrets manager / process env. Do not commit secrets.
#
# Domains (Approach A):
#   AI OS          → https://app.vtechdevelopment.com
#   Social Checker → https://social.vtechdevelopment.com  (same deploy; add Vercel domain)
#   Marketing      → https://vtechdevelopment.com         (Hostinger; not this app)

NODE_ENV=production
AUTH_SECRET=replace-with-long-random-string
NEXTAUTH_URL=https://app.vtechdevelopment.com
APP_URL=https://app.vtechdevelopment.com
# Optional alias used by some integration checklists
# APP_ORIGIN=https://app.vtechdevelopment.com
DATABASE_URL=postgresql://USER:PASS@HOST:5432/vibetech

# Public Social Checker (Serper only — not full FCRA screening)
# SERPER_API_KEY=
# Optional daily soft cap per IP for /api/social-checker/search (default 20)
# SOCIAL_CHECKER_DAILY_LIMIT=20

# Invitation delivery — configure one of Resend or SMTP
INVITATION_EMAIL_FROM=VIBETech <invitations@vtechdevelopment.com>
INVITATION_DELIVERY_ENCRYPTION_KEY=replace-with-32+-char-secret
# RESEND_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Durable object storage volumes (persist across deploys)
KNOWLEDGE_STORAGE_DRIVER=local
KNOWLEDGE_STORAGE_ROOT=/var/lib/vibetech/knowledge-storage
IMPORT_STORAGE_ROOT=/var/lib/vibetech/import-storage
